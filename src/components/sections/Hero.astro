---
import T from './../T.astro';
import { hero } from '../../data/content';
---

<section class="hero shell">
  <div class="blob blob--yellow" aria-hidden="true"></div>
  <div class="blob blob--teal" aria-hidden="true"></div>

  <div class="hero__inner">
    <p class="eyebrow hero__eyebrow" data-reveal><T t={hero.eyebrow} /></p>

    <h1 class="hero__title" data-reveal>
      <T>
        <Fragment slot="fr"
          >Je construis des applis web avec <span class="r">R</span> &amp; <span
            class="py">Python</span
          >.</Fragment
        >
        <Fragment slot="en"
          >I build web apps with <span class="r">R</span> &amp; <span class="py"
            >Python</span
          >.</Fragment
        >
      </T>
    </h1>

    <p class="hero__lede" data-reveal><T t={hero.lede} /></p>

    <div class="btn-row" data-reveal>
      <a href="#contact" class="btn btn--ink">
        <T t={{ fr: 'Me contacter', en: 'Get in touch' }} />
      </a>
      <a href="#hyperverse" class="btn btn--outline">
        <T t={{ fr: 'Voir mes projets', en: 'See my work' }} />
      </a>
    </div>
  </div>
</section>
