---
import T from './../T.astro';
import NewTab from './../NewTab.astro';
import { articles } from '../../data/articles';
---

<section id="articles" class="section shell">
  <h2 class="section__title" data-reveal>Articles</h2>

  <p class="section__lede" data-reveal>
    <T
      t={{
        fr: "Des articles que j'ai écrits pour Rtask, le blog de ThinkR.",
        en: 'Articles I wrote for Rtask, the ThinkR blog.',
      }}
    />
  </p>

  <div class="article-grid">
    {
      articles.map((article) => (
        <a class="article" data-reveal href={article.href} target="_blank" rel="noopener">
          <p class="article__meta">
            {article.source} · <time datetime={article.iso}><T t={article.date} /></time>
          </p>
          <h3 class="article__title">{article.title}</h3>
          <p class="article__text">
            <T t={article.summary} />
          </p>
          <NewTab />
        </a>
      ))
    }
  </div>
</section>
