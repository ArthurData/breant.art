---
import T from './../T.astro';
import { articles } from '../../data/articles';
---

<section id="articles" class="section shell">
  <h2 class="section__title" style="margin-bottom:28px" data-reveal>Articles</h2>

  <div class="article-grid">
    {
      articles.map((article) => (
        <a class="article" data-reveal href={article.href} rel="noopener">
          <p class="article__meta">
            {article.source} · <time datetime={article.iso}><T t={article.date} /></time>
          </p>
          <h3 class="article__title">{article.title}</h3>
          <p class="article__text">
            <T t={article.summary} />
          </p>
        </a>
      ))
    }
  </div>
</section>
