---
import T from './T.astro';
import { nav } from '../data/site';
import { locales, localePath, resolveLocale } from '../data/types';

const lang = resolveLocale(Astro.currentLocale);
---

<header class="header">
  <div class="header__inner">
    <a href={localePath(lang)} class="brand">breant<span>.art</span></a>

    <nav class="header__nav" aria-label="Sections">
      {nav.map(({ href, label }) => <a href={href}><T t={label} /></a>)}
    </nav>

    <div class="header__tools">
      <nav class="lang" aria-labelledby="lang-label">
        <span class="sr-only" id="lang-label"
          ><T t={{ fr: 'Changer de langue', en: 'Change language' }} /></span
        >
        {
          locales.map((loc) => (
            <a
              class="lang__btn"
              href={localePath(loc)}
              hreflang={loc}
              lang={loc}
              aria-current={loc === lang ? 'page' : undefined}
            >
              {loc.toUpperCase()}
            </a>
          ))
        }
      </nav>

      <button type="button" class="theme-toggle" data-theme-toggle>
        <span class="sr-only"
          ><T t={{ fr: 'Changer de thème', en: 'Toggle theme' }} /></span
        >
        <svg
          class="icon-moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
        <svg
          class="icon-sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path
            d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          />
        </svg>
      </button>

      <a href="#contact" class="header__cta">
        <T t={{ fr: 'Me contacter', en: 'Contact' }} />
      </a>
    </div>
  </div>
</header>
