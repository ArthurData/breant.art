---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Runtime from '../components/Runtime.astro';
import T from '../components/T.astro';

import Hero from '../components/sections/Hero.astro';
import Pillars from '../components/sections/Pillars.astro';
import Hyperverse from '../components/sections/Hyperverse.astro';
import Topiq from '../components/sections/Topiq.astro';
import Projects from '../components/sections/Projects.astro';
import Talks from '../components/sections/Talks.astro';
import Articles from '../components/sections/Articles.astro';
import Pedagogy from '../components/sections/Pedagogy.astro';
import SpeakerKit from '../components/sections/SpeakerKit.astro';
import Contact from '../components/sections/Contact.astro';
---

<BaseLayout>
  <a href="#top" class="skip-link">
    <T t={{ fr: 'Aller au contenu', en: 'Skip to content' }} />
  </a>

  <Header />

  <main id="top">
    <Hero />
    <Pillars />
    <Hyperverse />
    <Topiq />
    <Projects />
    <Talks />
    <Articles />
    <Pedagogy />
    <SpeakerKit />
    <Contact />
  </main>

  <Footer />
  <Runtime />
</BaseLayout>
